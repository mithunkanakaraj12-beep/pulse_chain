# Copy to .env and adjust. Nothing here is required for the demo to run.

# --- Server ---
PULSECHAIN_HOST=127.0.0.1
PULSECHAIN_PORT=8000
PULSECHAIN_DB_PATH=data/pulsechain.db
PULSECHAIN_MODEL_DIR=data/models
PULSECHAIN_SEED=42

# --- Alerting ---
# Risk level at or above which an SMS warning is generated: moderate | high | critical
ALERT_RISK_THRESHOLD=high

# --- SMS ---
# "simulated" (default) never contacts Twilio. "live" additionally requires ALL of the Twilio
# variables below AND SMS_ALLOW_LIVE=true AND an explicit confirm flag on each send request.
SMS_MODE=simulated
SMS_ALLOW_LIVE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Weather (Open-Meteo, no API key required) ---
# When disabled or unreachable the app falls back to the synthetic weather dataset.
OPEN_METEO_ENABLED=false
OPEN_METEO_TIMEOUT_SECONDS=6
